<p>
    <form method="post" action="/nodes/check-node/" class="form-inline" id="check-node"><input type='hidden' name='csrfmiddlewaretoken' value='WizIz363yzSdgDiPwBN3ozbm4XYI7KnTxCazLZPia4kAewmNHPH5HpFfBCkVFOdN' />
        <div class="form-group"><input type="text" class="form-control input-sm" size="30" id="address" name="address" placeholder="IPv4/IPv6/.onion" value="207.241.226.231"></div>
